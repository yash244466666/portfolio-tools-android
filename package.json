{
  "name": "portfolio-tools-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "contrast:check": "node scripts/check-token-contrast.mjs",
    "css:tokens:check": "node scripts/check-css-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "regression:matrix": "node scripts/build-regression-matrix.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm css:tokens:check && pnpm contrast:check && pnpm test && pnpm build && node scripts/check-pdf-worker-polyfill.mjs",
    "cap:sync": "cap sync android",
    "android:manifest:check": "node scripts/check-android-manifest.mjs",
    "android:test:connected": "./android/gradlew -p android :app:connectedDebugAndroidTest",
    "android:test:process-recreation": "node scripts/test-android-process-recreation.mjs",
    "github:actions:check": "node scripts/check-github-actions.ts",
    "github:work-items:check": "node scripts/setup-github-work-management.ts",
    "github:work-items:apply": "node scripts/setup-github-work-management.ts --apply",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:debug": "pnpm build && cap sync android && ./android/gradlew -p android assembleDebug && pnpm android:manifest:check debug",
    "android:bundle": "pnpm build && cap sync android && ./android/gradlew -p android bundleRelease && pnpm android:manifest:check release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "diff": "9.0.0",
    "dompurify": "3.4.14",
    "js-yaml": "4.3.1",
    "jszip": "3.10.1",
    "lucide-react": "1.41.0",
    "marked": "18.0.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql-formatter": "15.7.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
